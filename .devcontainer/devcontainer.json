{
  "name": "Python 3 & Streamlit Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm", // 升級到 3.12，穩定且支援最新 Streamlit
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "streamlit_app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // 容器建立後跑一次：建立 venv + 安裝套件
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements.txt && mkdir -p /home/vscode/.streamlit && printf '[general]\nemail = \"admin@red-publish.com\"\n' > /home/vscode/.streamlit/credentials.toml",
  // 每次容器啟動時在背景啟動 Streamlit
  "postStartCommand": "/bin/bash .devcontainer/start_streamlit.sh",
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "notify" // 避免在容器內呼叫 gio 開啟瀏覽器
    }
  }
}